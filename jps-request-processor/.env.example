# Copy to .env and fill in. Never commit the real file — .gitignore already
# excludes it. Everything secret lives here and nowhere else.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Public https URL of this service. Used for the webhook callback and for the
# dashboard links inside Telegram alerts. No trailing slash.
PUBLIC_URL=https://jps-requests.example.com
LOG_LEVEL=info

# ─── Storage ──────────────────────────────────────────────────────────────────
# sqlite  — zero setup, needs a persistent disk (a Fly volume, a VPS, your laptop)
# supabase — use when the host's filesystem is ephemeral. Run src/db/schema.sql first.
STORE_DRIVER=sqlite
SQLITE_PATH=./data/jps.db

# Only for STORE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_PREFIX=jps_

# ─── Meta / Messenger ─────────────────────────────────────────────────────────
# Any random string. You type the same value into Meta's webhook setup form.
FB_VERIFY_TOKEN=
# Meta App Secret — used to verify that a webhook really came from Meta.
FB_APP_SECRET=
# Page access token. Not needed for the MVP (we never reply); required later.
FB_PAGE_ACCESS_TOKEN=
# Set to false ONLY for local testing with curl. Never in production.
FB_REQUIRE_SIGNATURE=true

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — how much reasoning to spend per message.
AI_EFFORT=medium
AI_MAX_TOKENS=8000
AI_TIMEOUT_MS=180000

# ─── Processing ───────────────────────────────────────────────────────────────
# How long a client must stop typing before their burst is treated as one request.
MESSAGE_DEBOUNCE_MS=60000
SCHEDULER_INTERVAL_MS=5000
SCHEDULER_BATCH_LIMIT=5
MAX_PROCESSING_ATTEMPTS=5
RETRY_BASE_MS=30000
# Conversation and history the AI is allowed to see.
CONTEXT_MESSAGE_LIMIT=20
CONTEXT_WINDOW_HOURS=72
CONTEXT_REQUEST_LIMIT=5
# Below this confidence a change request is held for clarification, not marked ready.
CONFIDENCE_THRESHOLD=0.6

# ─── Notifications ────────────────────────────────────────────────────────────
# Optional. Without these, requests only appear in the dashboard and the logs.
# Create the bot with @BotFather; get the chat id by messaging the bot and
# opening https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_POSSIBLE_CHANGE=true

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Shared secret for the internal dashboard. Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=
DASHBOARD_ENABLED=true
