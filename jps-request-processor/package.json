{
  "name": "jps-request-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Turns JPS Solutions client Facebook messages into review-ready Lovable implementation prompts.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clients": "node --disable-warning=ExperimentalWarning scripts/clients.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@supabase/supabase-js": "^2.112.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
